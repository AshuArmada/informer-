# Postgres connection (matches docker-compose.yml defaults; container uses host port 5433
# to avoid colliding with any native Postgres install on 5432)
DATABASE_URL=postgresql+asyncpg://informer:informer@localhost:5433/informer

# Fernet key used to encrypt the GitHub PAT and UI provider settings at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# How often (minutes) the trending poller hits the GitHub Search API.
POLL_INTERVAL_MINUTES=10

# Optional installation defaults. Settings -> AI connections overrides these
# without a restart. Keys saved through the UI are encrypted in PostgreSQL.
AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Local Ollama: run `ollama pull llama3.2:3b`, then start Ollama.
# Set AI_PROVIDER=ollama to select it by default. No API key needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# SMTP (used to send reports). Example values for Gmail with an app password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional default destination for reports; pre-fills the send form and is used by the schedule.
DEFAULT_REPORT_EMAIL=

# Note: the GitHub PAT itself is NOT set here — it's entered via the in-app
# Settings page and stored encrypted in the database.
